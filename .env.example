# Copia este archivo a .env y ajusta los valores.

POSTGRES_DB=recetas
POSTGRES_USER=recetas
POSTGRES_PASSWORD=cambia-esto

# ---------------------------------------------------------------
# PRODUCCIÓN (por defecto): sin proxy, IA con Ollama
# ---------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434   # Ollama en la misma máquina (o http://IP:11434)
OLLAMA_MODEL=qwen2.5:7b                         # cualquier modelo que tengas: `ollama list`
LLM_TIMEOUT=300                                 # segundos; los modelos locales pueden tardar

# ---------------------------------------------------------------
# DEV: proxy corporativo + Claude. Descomenta estas líneas en el .env de dev.
# ---------------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
