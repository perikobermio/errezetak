# Copia este archivo a .env y ajusta los valores.

POSTGRES_DB=recetas
POSTGRES_USER=recetas
POSTGRES_PASSWORD=cambia-esto

# ---------------------------------------------------------------
# PRODUCCIÓN (por defecto): sin proxy, IA con OpenCode Go
# ---------------------------------------------------------------
LLM_PROVIDER=opencode
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_API_KEY=oc_sk_...                       # clave de OpenCode Go (Console › API keys)
OPENCODE_MODEL=deepseek-v4.1-flash               # cualquier modelo de OpenCode Go
LLM_TIMEOUT=300                                  # segundos
# POSTGRES_HOST_PORT=5433                       # puerto local de Postgres (solo 127.0.0.1)

# ---------------------------------------------------------------
# DEV: proxy corporativo + Claude. Descomenta estas líneas en el .env de dev.
# ---------------------------------------------------------------
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
